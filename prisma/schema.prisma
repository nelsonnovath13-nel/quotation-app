// Core slice schema. Designed so the full spec (many products, configurable
// pricing rules, follow-ups, terms, templates) can be added without
// restructuring these tables — everything is already company-scoped.

datasource db {
  provider = "sqlite" // swap to "postgresql" + DATABASE_URL for production
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum ProjectStatus {
  NEW
  MEASUREMENT
  QUOTATION
  FOLLOW_UP
  APPROVED
  PRODUCTION
  INSTALLATION
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  FOLLOW_UP
  NEGOTIATING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

model Company {
  id            String   @id @default(cuid())
  name          String
  brandName     String?
  phone         String
  whatsapp      String?
  email         String
  address       String
  city          String
  country       String
  currency      String   @default("TZS")
  description   String?
  logoUrl       String?
  website       String?
  taxNumber     String?
  regNumber     String?
  tagline       String?
  quotationValidityDays Int  @default(14)
  paymentTerms  String?
  warrantyTerms String?
  deliveryTerms String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users       User[]
  customers   Customer[]
  products    Product[]
  materials   Material[]
  quotations  Quotation[]
}

model User {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String   @unique
  role      Role     @default(EMPLOYEE)
  canSeePricingConfig Boolean @default(false)
  createdAt DateTime @default(now())
}

model Customer {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  fullName      String
  phone         String
  whatsapp      String?
  email         String?
  address       String?
  city          String?
  projectLocation String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects   Project[]
  quotations Quotation[]

  @@index([companyId])
}

model Project {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  name        String
  projectType String
  location    String?
  description String?
  notes       String?
  driveLink   String?
  status      ProjectStatus @default(NEW)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  measurementItems MeasurementItem[]
  quotations       Quotation[]

  @@index([companyId])
  @@index([customerId])
}

// Product catalog entry (e.g. "Aluminium Sliding Window"). The MVP slice
// ships a working formula for one productKey ("ALU_SLIDING_WINDOW") but the
// table is generic so more can be added from the admin UI later.
model Product {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  category   String   // Aluminium | PVC | Steel
  name       String
  productKey String   // maps to a pricing formula implementation
  unit       String   @default("sqm")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([companyId])
}

model Material {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  materialKey String  // e.g. ALU_PROFILE, GLASS_5MM, LABOUR, INSTALLATION
  unit       String   // meter | sqm | piece | kg | set | hour | job | fixed
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  rates MaterialRate[]

  @@index([companyId])
}

// Rate history — never edited in place, only appended to, so past
// quotations can always be traced back to the rate that produced them.
model MaterialRate {
  id            String   @id @default(cuid())
  materialId    String
  material      Material @relation(fields: [materialId], references: [id])
  rate          Float
  effectiveDate DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  @@index([materialId, effectiveDate])
}

model MeasurementItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  ref         String   // e.g. W01
  productKey  String   // e.g. ALU_SLIDING_WINDOW
  productName String
  widthMm     Float
  heightMm    Float
  quantity    Int
  spec        Json?    // product-specific extra fields (glass type, frame, lock, etc.)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Quotation {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  number       String   @unique
  status       QuotationStatus @default(DRAFT)
  currency     String
  subtotal     Float
  discount     Float    @default(0)
  tax          Float    @default(0)
  total        Float
  validUntil   DateTime
  preparedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items    QuotationItem[]
  snapshot QuotationPriceSnapshot?
  followUps FollowUp[]
}

model QuotationItem {
  id          String   @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  ref         String
  description String
  size        String
  quantity    Int
  unit        String
  unitPrice   Float
  amount      Float
}

// The full calculation breakdown used to produce the quotation, frozen at
// generation time. Rate changes afterwards must never touch this record.
model QuotationPriceSnapshot {
  id          String   @id @default(cuid())
  quotationId String   @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  ratesUsed   Json     // { materialKey: { rate, effectiveDate } }
  breakdown   Json     // per-item cost breakdown (material/glass/labour/etc.)
  marginPct   Float
  createdAt   DateTime @default(now())
}

model FollowUp {
  id             String   @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id])
  note           String
  followUpDate   DateTime
  nextFollowUpDate DateTime?
  status         String
  createdAt      DateTime @default(now())

  @@index([quotationId])
}
