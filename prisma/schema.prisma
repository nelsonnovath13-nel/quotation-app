// Production schema for the quotation MVP.
// PostgreSQL is used for persistent production storage.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role { ADMIN EMPLOYEE }
enum ProjectStatus { NEW MEASUREMENT QUOTATION FOLLOW_UP APPROVED PRODUCTION INSTALLATION COMPLETED CANCELLED }
enum QuotationStatus { DRAFT SENT FOLLOW_UP NEGOTIATING APPROVED REJECTED EXPIRED CANCELLED }

model Company {
  id String @id @default(cuid())
  name String
  brandName String?
  phone String
  whatsapp String?
  email String
  address String
  city String
  country String
  currency String @default("TZS")
  description String?
  logoUrl String?
  website String?
  taxNumber String?
  regNumber String?
  tagline String?
  quotationValidityDays Int @default(14)
  paymentTerms String?
  warrantyTerms String?
  deliveryTerms String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  customers Customer[]
  products Product[]
  materials Material[]
  quotations Quotation[]
  @@index([name])
}

model User {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  name String
  email String @unique
  role Role @default(EMPLOYEE)
  canSeePricingConfig Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([companyId])
}

model Customer {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  fullName String
  phone String
  whatsapp String?
  email String?
  address String?
  city String?
  projectLocation String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects Project[]
  quotations Quotation[]
  @@index([companyId])
  @@index([phone])
}

model Project {
  id String @id @default(cuid())
  companyId String
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  name String
  projectType String
  location String?
  description String?
  notes String?
  driveLink String?
  status ProjectStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  measurementItems MeasurementItem[]
  quotations Quotation[]
  @@index([companyId])
  @@index([customerId])
}

model Product {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  category String
  name String
  productKey String
  unit String @default("sqm")
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([companyId, productKey])
  @@index([companyId, category])
}

model Material {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  name String
  materialKey String
  unit String
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  rates MaterialRate[]
  @@unique([companyId, materialKey])
  @@index([companyId])
}

model MaterialRate {
  id String @id @default(cuid())
  materialId String
  material Material @relation(fields: [materialId], references: [id])
  rate Float
  effectiveDate DateTime @default(now())
  notes String?
  createdAt DateTime @default(now())
  @@index([materialId, effectiveDate])
}

model MeasurementItem {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  ref String
  productKey String
  productName String
  widthMm Float
  heightMm Float
  quantity Int
  spec Json?
  notes String?
  createdAt DateTime @default(now())
  @@index([projectId, productKey])
}

model Quotation {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  number String @unique
  status QuotationStatus @default(DRAFT)
  currency String
  subtotal Float
  discount Float @default(0)
  tax Float @default(0)
  total Float
  validUntil DateTime
  preparedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items QuotationItem[]
  snapshot QuotationPriceSnapshot?
  followUps FollowUp[]
  @@index([companyId, status])
  @@index([customerId])
  @@index([projectId])
}

model QuotationItem {
  id String @id @default(cuid())
  quotationId String
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  ref String
  category String?
  productKey String?
  description String
  size String
  quantity Int
  unit String
  unitPrice Float
  amount Float
  @@index([quotationId])
}

model QuotationPriceSnapshot {
  id String @id @default(cuid())
  quotationId String @unique
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  ratesUsed Json
  breakdown Json
  marginPct Float
  createdAt DateTime @default(now())
}

model FollowUp {
  id String @id @default(cuid())
  quotationId String
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  note String
  followUpDate DateTime
  nextFollowUpDate DateTime?
  status String
  createdAt DateTime @default(now())
  @@index([quotationId, followUpDate])
}
